<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="empty_world">
    <!-- Physics settings -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
    </physics>

    <!-- Ground plane (optional) -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Sunlight -->
    <include>
      <uri>model://sun</uri>
    </include>

  </world>
</sdf>
